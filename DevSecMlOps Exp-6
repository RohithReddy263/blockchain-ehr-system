          "text": [
            "=== ML Pipeline RBAC ===\n",
            "[ALLOW] admin -> deploy\n",
            "[ALLOW] data_scientist -> train\n",
            "[DENY] viewer -> train\n",
            "[ALLOW] ml_engineer -> deploy\n"
          ]
        }
      ],
      "source": [
        "from datetime import datetime\n",
        "\n",
        "# Roles and permissions\n",
        "ROLES = {\n",
        "    \"data_engineer\": {\"extract\", \"transform\"},\n",
        "    \"data_scientist\": {\"train\", \"evaluate\"},\n",
        "    \"ml_engineer\": {\"train\", \"deploy\"},\n",
        "    \"admin\": {\"extract\", \"transform\", \"train\", \"evaluate\", \"deploy\"},\n",
        "    \"viewer\": {\"view\"}\n",
        "}\n",
        "\n",
        "# Audit log\n",
        "audit_log = []\n",
        "\n",
        "\n",
        "def check_access(role, action):\n",
        "    if action in ROLES.get(role, set()):\n",
        "        result = \"ALLOW\"\n",
        "        print(f\"[ALLOW] {role} -> {action}\")\n",
        "    else:\n",
        "        result = \"DENY\"\n",
        "        print(f\"[DENY] {role} -> {action}\")\n",
        "\n",
        "    audit_log.append({\n",
        "        \"time\": datetime.now().strftime(\"%H:%M:%S\"),\n",
        "        \"role\": role,\n",
        "        \"action\": action,\n",
        "        \"result\": result\n",
        "    })\n",
        "\n",
        "\n",
        "print(\"=== ML Pipeline RBAC ===\")\n",
        "\n",
        "check_access(\"admin\", \"deploy\")\n",
        "check_access(\"data_scientist\", \"train\")\n",
        "check_access(\"viewer\", \"train\")\n",
        "check_access(\"ml_engineer\", \"deploy\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"=== Audit Log ===\")\n",
        "\n",
        "for log in audit_log:\n",
        "    print(\n",
        "        log[\"time\"],\n",
        "        \"|\", log[\"role\"],\n",
        "        \"|\", log[\"action\"],\n",
        "        \"|\", log[\"result\"]\n",
        "    )"
      ],
